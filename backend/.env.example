# Local dev: points at the docker-compose postgres service.
# Production (Render): set this to the Supabase connection string instead —
# the docker-compose postgres container is never used in production.
DATABASE_URL=postgresql+psycopg2://blood_donation:blood_donation@postgres:5432/blood_donation

ENVIRONMENT=local

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CONSENT_POLICY_VERSION=v1.0

# Explicit origins only — required for CORS to work with the HttpOnly refresh cookie.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Only used by docker-compose's local postgres container.
POSTGRES_USER=blood_donation
POSTGRES_PASSWORD=blood_donation
POSTGRES_DB=blood_donation
